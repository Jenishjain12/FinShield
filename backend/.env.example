DATABASE_URL=sqlite:///../data/finshield.db
# In local development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In production on Render (replace with your Vercel URL):
# CORS_ORIGINS=https://<your-app>.vercel.app
# Optional regex to support Vercel preview/branch deployments:
# CORS_ORIGIN_REGEX=^https://finshield-[a-z0-9-]+\.vercel\.app$
SIMILARITY_THRESHOLD=0.72

# NVIDIA Nemotron Investigation Copilot (Primary)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional Fallback Providers
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
