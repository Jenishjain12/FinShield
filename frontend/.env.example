# FIN-SHIELD Frontend Environment Configuration

# Local development:
VITE_API_BASE_URL=http://127.0.0.1:8000

# On Vercel:
# Set VITE_API_BASE_URL to your Render web service URL with NO trailing slash
# Example: VITE_API_BASE_URL=https://finshield-api.onrender.com
# NOTE: In Vite, VITE_* environment variables are baked in at BUILD time.
# Changing this variable in the Vercel project settings requires triggering a new Deployment.

